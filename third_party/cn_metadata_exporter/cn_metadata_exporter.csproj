<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Cpp2ILRoot Condition="'$(Cpp2ILRoot)' == ''">../Cpp2IL</Cpp2ILRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Cpp2ILRoot)/LibCpp2IL/LibCpp2IL.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
</Project>
